# The plan check (ADR 0014): Claude Code compares the pull request with the
# plan.md of its plan, bfc check record stores the result in the Plans ref,
# and this workflow labels the pull request and posts one comment. It warns;
# it never blocks merging.
#
[[- if .FromSource]]
# BeforeCode checks itself with the bfc built from the pull request's own
# source; bfc setup github writes the same workflow for other repositories,
# with the released bfc that wrote it.
[[- else]]
# It needs the ANTHROPIC_API_KEY repository secret. It runs bfc [[.Version]],
# the release of the bfc that wrote this file: run bfc setup github again
# after updating bfc.
[[- end]]
name: Plan check

on:
  pull_request:
    types: [opened, synchronize, reopened, edited]

permissions:
  contents: write # push refs/beforecode/plans (ADR 0001)
  pull-requests: write # the plan-mismatch label and the comment

concurrency:
  group: bfc-plan-check-${{ github.event.pull_request.number }}
  # A run is never cut between storing the result and labelling.
  cancel-in-progress: false

jobs:
  check:
    name: Plan check
    runs-on: ubuntu-latest
    env:
      # Untrusted values reach the scripts only through the environment.
      PR_NUMBER: ${{ github.event.pull_request.number }}
      HEAD_REF: ${{ github.event.pull_request.head.ref }}
      HEAD_SHA: ${{ github.event.pull_request.head.sha }}
      BASE_SHA: ${{ github.event.pull_request.base.sha }}
      PR_BODY: ${{ github.event.pull_request.body }}
      GH_REPO: ${{ github.repository }}
      # The Claude Code release the agent adapter was recorded with.
      CLAUDE_CODE_VERSION: 2.1.328
    steps:
      - name: Skip pull requests from forks
        id: fork
        if: github.event.pull_request.head.repo.full_name != github.repository
        run: |
          echo "skip=true" >> "$GITHUB_OUTPUT"
          echo "Plan check skipped: pull requests from forks get a read-only token, so the result cannot be stored (#29)." >> "$GITHUB_STEP_SUMMARY"

      - uses: actions/checkout@v7
        if: steps.fork.outputs.skip != 'true'
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          fetch-depth: 0
          # No token in .git/config while Claude Code runs; the steps that
          # fetch and push get it through the environment.
          persist-credentials: false
[[- if .FromSource]]

      - uses: actions/setup-go@v7
        if: steps.fork.outputs.skip != 'true'
        with:
          go-version-file: go.mod

      - name: Build bfc from this pull request
        if: steps.fork.outputs.skip != 'true'
        run: |
          go build -o "$RUNNER_TEMP/bin/bfc" ./cmd/bfc
          echo "$RUNNER_TEMP/bin" >> "$GITHUB_PATH"
[[- else]]

      - name: Install bfc [[.Version]]
        if: steps.fork.outputs.skip != 'true'
        env:
          BFC_VERSION: [[.Version]]
        run: |
          # The release archive and checksums.txt as .goreleaser.yaml names them.
          archive="bfc_${BFC_VERSION#v}_linux_amd64.tar.gz"
          base="https://github.com/admSla99/BeforeCode/releases/download/$BFC_VERSION"
          cd "$RUNNER_TEMP"
          curl --proto =https --fail --silent --show-error --location --retry 3 --remote-name "$base/$archive"
          curl --proto =https --fail --silent --show-error --location --retry 3 --remote-name "$base/checksums.txt"
          # sha256sum fails when grep finds no line for the archive.
          grep -F "  $archive" checksums.txt | sha256sum --check --strict -
          mkdir -p "$RUNNER_TEMP/bin"
          tar -xzf "$archive" -C "$RUNNER_TEMP/bin" bfc
          echo "$RUNNER_TEMP/bin" >> "$GITHUB_PATH"
[[- end]]

      - name: Set the git identity of the results
        if: steps.fork.outputs.skip != 'true'
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

      - name: Find the plan
        id: plan
        if: steps.fork.outputs.skip != 'true'
        env:
          TOKEN: ${{ github.token }}
        run: |
          # The token as git configuration that lives only in this step.
          export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0="http.https://github.com/.extraheader"
          GIT_CONFIG_VALUE_0="AUTHORIZATION: basic $(printf 'x-access-token:%s' "$TOKEN" | base64 -w0)"
          export GIT_CONFIG_VALUE_0
          # Pushes to the Plans ref trigger no workflow, so fetch it here.
          if [ -z "$(git ls-remote origin refs/beforecode/plans)" ]; then
            echo "found=false" >> "$GITHUB_OUTPUT"
            echo "Plan check skipped: this repository has no plans in refs/beforecode/plans." >> "$GITHUB_STEP_SUMMARY"
            exit 0
          fi
          bfc bootstrap
          printf '%s' "$PR_BODY" > "$RUNNER_TEMP/body.md"
          bfc check find --branch "$HEAD_REF" --body-file "$RUNNER_TEMP/body.md" --json > "$RUNNER_TEMP/plan.json"
          cat "$RUNNER_TEMP/plan.json"
          if [ "$(jq -r .found "$RUNNER_TEMP/plan.json")" != true ]; then
            echo "found=false" >> "$GITHUB_OUTPUT"
            echo "Plan check skipped: no plan found. Name the plan's Short ID in the branch name (bfc start does) or add a line \`Plan: bfc-…\` to the description." >> "$GITHUB_STEP_SUMMARY"
            exit 0
          fi
          # A result can be stored only in a Plans ref this bfc writes.
          version=$(git show refs/beforecode/plans:format-version)
          if [ "$version" != 2 ]; then
            echo "::error::The Plans ref has format-version $version; run bfc migrate and bfc push once, then push again to this pull request."
            exit 1
          fi
          {
            echo "found=true"
            echo "id=$(jq -r .id "$RUNNER_TEMP/plan.json")"
            echo "short_id=$(jq -r .short_id "$RUNNER_TEMP/plan.json")"
            echo "state=$(jq -r .state "$RUNNER_TEMP/plan.json")"
          } >> "$GITHUB_OUTPUT"

      - name: Check that the ANTHROPIC_API_KEY secret is set
        if: steps.plan.outputs.found == 'true'
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
        run: |
          if [ -z "$ANTHROPIC_API_KEY" ]; then
            echo "::error::The plan check needs the ANTHROPIC_API_KEY repository secret. Add it under Settings > Secrets and variables > Actions > New repository secret, or with gh secret set ANTHROPIC_API_KEY."
            exit 1
          fi

      - name: Run Claude Code
        if: steps.plan.outputs.found == 'true'
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
          PLAN_ID: ${{ steps.plan.outputs.id }}
        run: |
          npm install --global "@anthropic-ai/claude-code@$CLAUDE_CODE_VERSION"
          prompt="$(bfc prime check "$PLAN_ID")

          ## The pull request

          Pull request #$PR_NUMBER. Base commit: $BASE_SHA. Head commit: $HEAD_SHA.
          Compare them with \`git diff $BASE_SHA...$HEAD_SHA\`."
          # Only reading tools: the check edits nothing (ADR 0014).
          claude -p --output-format text \
            --allowedTools Read Grep Glob "Bash(git diff:*)" "Bash(git log:*)" "Bash(bfc show:*)" "Bash(bfc prime:*)" \
            --disallowedTools Edit Write NotebookEdit WebFetch WebSearch \
            -- "$prompt" > "$RUNNER_TEMP/reply.md"
          cat "$RUNNER_TEMP/reply.md"
          # The check reads only; a changed checkout means it did not.
          if [ -n "$(git status --porcelain)" ]; then
            git status --short
            echo "::error::The checkout changed while Claude Code ran; the result is not stored."
            exit 1
          fi
          if grep -qF "$ANTHROPIC_API_KEY" "$RUNNER_TEMP/reply.md"; then
            echo "::error::The reply contains the API key; the result is not stored."
            exit 1
          fi

      - name: Record the result
        id: record
        if: steps.plan.outputs.found == 'true'
        env:
          PLAN_ID: ${{ steps.plan.outputs.id }}
          TOKEN: ${{ github.token }}
          # bfc records the harness that wrote the result as the agent.
          CLAUDECODE: "1"
        run: |
          # The token for the push, and no git hooks: the checkout was in an
          # agent's hands.
          export GIT_CONFIG_COUNT=2 GIT_CONFIG_KEY_0="http.https://github.com/.extraheader" GIT_CONFIG_KEY_1=core.hooksPath GIT_CONFIG_VALUE_1=/dev/null
          GIT_CONFIG_VALUE_0="AUTHORIZATION: basic $(printf 'x-access-token:%s' "$TOKEN" | base64 -w0)"
          export GIT_CONFIG_VALUE_0
          bfc check record "$PLAN_ID" --pr "$PR_NUMBER" --head "$HEAD_SHA" --base "$BASE_SHA" --json \
            < "$RUNNER_TEMP/reply.md" > "$RUNNER_TEMP/check.json"
          findings=$(jq '[.criteria[] | select(.status == "not-met")] + .out_of_scope | length' "$RUNNER_TEMP/check.json")
          echo "findings=$findings" >> "$GITHUB_OUTPUT"
          # Merges and retries when someone pushed first; never forced.
          bfc push

      - name: Label and comment
        if: steps.plan.outputs.found == 'true'
        env:
          GH_TOKEN: ${{ github.token }}
          SHORT_ID: ${{ steps.plan.outputs.short_id }}
          STATE: ${{ steps.plan.outputs.state }}
          FINDINGS: ${{ steps.record.outputs.findings }}
        run: |
          marker='<!-- bfc-plan-check -->'
          {
            echo "$marker"
            case "$STATE" in
              approved|in-progress) ;;
              *) echo "**Note:** plan $SHORT_ID is \`$STATE\`, not approved; it was checked anyway."; echo ;;
            esac
            echo "## Plan check: $SHORT_ID"
            echo
            jq -r .summary "$RUNNER_TEMP/check.json"
          } > "$RUNNER_TEMP/comment.md"
          # Only this workflow's own comment is updated.
          comment=$(gh api "repos/$GH_REPO/issues/$PR_NUMBER/comments" --paginate \
            --jq ".[] | select(.user.login == \"github-actions[bot]\" and (.body | startswith(\"$marker\"))) | .id" | head -n 1)
          if [ "$FINDINGS" -gt 0 ]; then
            gh label create plan-mismatch --color D93F0B --description "The pull request departs from its plan" 2>/dev/null || true
            gh pr edit "$PR_NUMBER" --add-label plan-mismatch
          else
            gh pr edit "$PR_NUMBER" --remove-label plan-mismatch 2>/dev/null || true
          fi
          if [ -n "$comment" ]; then
            gh api --method PATCH "repos/$GH_REPO/issues/comments/$comment" -F "body=@$RUNNER_TEMP/comment.md" > /dev/null
          elif [ "$FINDINGS" -gt 0 ]; then
            gh pr comment "$PR_NUMBER" --body-file "$RUNNER_TEMP/comment.md"
          fi
