{
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(go test:*)",
      "Bash(bfc show:*)",
      "Bash(bfc prime:*)",
      "Bash(bfc list:*)",
      "Bash(bfc ask:*)",
      "Bash(bfc reply:*)",
      "Bash(bfc edit:*)",
      "Bash(bfc start:*)"
    ],
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(bfc submit:*)",
      "Bash(bfc approve:*)",
      "Bash(bfc request-changes:*)",
      "Bash(bfc withdraw:*)",
      "Bash(bfc close:*)",
      "Bash(bfc acknowledge:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "gofmt -w ."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./check <cmd> && true"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bfc hook pre-tool-use"
          }
        ]
      }
    ]
  },
  "env": {
    "GOFLAGS": "-mod=mod"
  }
}
